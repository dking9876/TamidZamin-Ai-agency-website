{
  "name": "tamidzamin-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-decoration.mjs",
    "check": "astro check",
    "build": "astro check && astro build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:delivery": "node scripts/test-delivery.mjs",
    "test:seo": "node scripts/test-seo.mjs",
    "test:vercel": "node scripts/test-vercel.mjs",
    "verify:launch": "node --env-file-if-exists=.env scripts/verify-launch.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.13",
    "@astrojs/vercel": "11.0.22",
    "@fontsource-variable/heebo": "5.3.0",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "lighthouse": "13.6.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "~6.0.0"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
