---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';
---
<Layout title="יצירת קשר בוואטסאפ ובטלפון | TamidZamin" description="דברו עם דניאל וייצר על סוכני AI בוואטסאפ ובטלפון לעסק שלכם. פנייה ישירה בוואטסאפ או בטלפון 058-4345513, לעסקים בכל ישראל ובדגש על המרכז.">
  <PageHeading title="בואו נכיר את העסק שלכם." description="מה מגיע היום, מה מתפספס ואיפה אפשר לעשות סדר? דברו איתי בוואטסאפ או בטלפון ונבדוק יחד מה מתאים לעסק." />
  <section class="page-section"><div class="container contact-grid">
    <div class="direct-contact">
      <h2>מתחילים בשיחה עם דניאל.</h2>
      <p>אני {site.legalName}, המפעיל של <bdi>{site.name}</bdi>. אני מטפל בפניות ומלווה את ההיכרות עם העסק, הצרכים שלו והאפשרויות להמשך.</p>
      <div class="direct-actions">
        <a class="button" href={site.whatsappUrl}><Icon name="chat" size={23} />נדבר בוואטסאפ</a>
        <a class="button secondary" href={site.phoneUrl}><Icon name="phone" size={21} />התקשרו: <bdi>{site.phoneDisplay}</bdi></a>
      </div>
      <p class="contact-detail">כפתור הוואטסאפ פותח הודעה מוכנה. אפשר לערוך אותה, וההודעה נשלחת רק אם תבחרו לשלוח אותה בוואטסאפ.</p>
      <p><strong>אפשר לפנות בכל שעה, 24/7.</strong><br />הזמינות לקבלת פניות אינה התחייבות למענה אנושי מיידי.</p>
      <p>אין צורך לשלוח פרטי לקוחות, סיסמאות או מידע רגיש. מספיק לספר באיזה תחום אתם עובדים ומה הייתם רוצים לשפר.</p>
      <a class="text-link" href="/privacy/">איך אנחנו מטפלים במידע שלכם <Icon name="arrow" size={18} /></a>
    </div>
    <aside class="contact-aside">
      <h2>על מה נדבר?</h2>
      <ol>
        <li>איך הפניות מגיעות היום, ומה מעמיס עליכם בזמן העבודה.</li>
        <li>אילו משימות אפשר להגדיר לסוכן, ומה צריך להישאר אצלכם או אצל הצוות שלכם.</li>
        <li>מה יכללו האפיון, ההקמה והתמיכה, והאם יש בסיס להצעה שמתאימה לעסק.</li>
      </ol>
      <p>אנחנו עובדים עם עסקי שירות ובעלי מקצוע בכל ישראל, בדגש על המרכז. אפשר לקיים את שיחת ההיכרות גם אונליין.</p>
      <p>פנייה אינה הזמנת שירות או התחייבות לתשלום.</p>
      <a class="text-link" href="/faq/">לשאלות הנפוצות <Icon name="arrow" size={18} /></a>
      <div class="notice">
        <strong>בקשות פרטיות ונגישות</strong>
        <p>אפשר לפנות לדניאל גם בדוא״ל: <a href={`mailto:${site.email}`}><bdi>{site.email}</bdi></a>.</p>
      </div>
    </aside>
  </div></section>
</Layout>
<style>
  .direct-contact { min-width: 0; }
  .direct-contact h2 { font-size: clamp(1.7rem, 3vw, 2.2rem); }
  .direct-contact p { color: var(--muted); margin-block: 20px; max-width: 65ch; }
  .direct-contact strong { color: var(--ink); }
  .direct-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-block: 28px 16px; }
  .direct-actions .button { flex: 1 1 240px; }
  .contact-detail { font-size: 15px; }
  .contact-aside a { overflow-wrap: anywhere; }
</style>
