---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import Picture from '../../components/Picture.astro';
import CTA from '../../components/CTA.astro';
const trades = [
  { id: 'plumber', name: 'אינסטלטורים', text: 'כתובת, תיאור קצר של הבעיה ורמת הדחיפות — כדי להבין את הפנייה לפני שחוזרים ללקוח. לא אבחון מרחוק ולא הבטחה לטיפול חירום.' },
  { id: 'electrician', name: 'חשמלאים', text: 'קליטת בקשות שירות ואיסוף פרטי קשר. הסוכן אינו נותן הוראות עבודה בחשמל או הנחיות שעלולות לסכן את הפונה.' },
  { id: 'repair', name: 'טכנאי תיקונים', text: 'איזה ציוד דורש טיפול, מה הלקוח מתאר והיכן הוא נמצא. אפשר לבחון בקשת תמונה בוואטסאפ כשיש בכך צורך.' },
  { id: 'hvac', name: 'טכנאי מיזוג', text: 'איסוף מידע ראשוני לקראת חזרה ללקוח, גם בתקופות עומס. לא קובעים ביקור לפני אישור וחיבור לתהליך המתאים.' },
  { id: 'contractor', name: 'קבלנים ושיפוצניקים', text: 'תיאור העבודה המבוקשת, מיקום והעדפת זמן לשיחה. הסיכום עוזר להתחיל בירור אנושי ממקום מסודר, בלי להמציא הערכת מחיר.' },
];
---
<Layout title="השירותים שלנו | סוכני AI לעסקי שירות — TamidZamin" description="מענה בוואטסאפ ובטלפון, איסוף פרטים והעברה לאדם. הכירו את תחומי האפיון של TamidZamin ואת תהליך בדיקת ההתאמה לעסק שלכם.">
  <PageHeading title="מענה שמתאים לעבודה שלכם." description="מתחילים בתהליך של העסק — לא ברשימת הבטחות של טכנולוגיה." />
  <section class="page-section"><div class="container">
    <div class="service-grid">
      <article class="service-detail"><Icon name="chat" size={36} /><h2>סוכן AI בוואטסאפ</h2><p>ערוץ כתוב שבו הלקוח יכול להסביר מה הוא צריך, להשלים פרטים ולאשר סיכום לקראת המשך טיפול.</p><ul><li>שיחה קצרה וממוקדת</li><li>איסוף מידע ותמונות לפי צורך</li><li>הגדרת מצבים להעברה לאדם</li></ul><a class="text-link" href="/services/whatsapp/">להכיר את התהליך <Icon name="arrow" size={18} /></a></article>
      <article class="service-detail"><Icon name="phone" size={36} /><h2>סוכן AI טלפוני</h2><p>תהליך קולי למי שמעדיף להתקשר: הבנת הפנייה, איסוף המידע הנדרש וסיכום ברור לבעל העסק.</p><ul><li>קליטת סיבת הפנייה</li><li>בירור דחיפות והעדפת זמינות</li><li>הקראת סיכום ואישורו</li></ul><a class="text-link" href="/services/phone/">להכיר את התהליך <Icon name="arrow" size={18} /></a></article>
    </div>
    <div class="notice"><strong>מה שמתאים על הנייר צריך לעבוד גם בפועל.</strong><p>זמינות הערוצים, השפות והחיבורים אינה מאושרת כאן מראש. כל פתרון דורש בדיקת התאמה, הגדרת גבולות ובדיקות לפני הפעלה. זהו אינו מוקד חירום.</p></div>
    <h2>מההיכרות עם העסק — לבדיקה מסודרת.</h2>
    <ol class="process"><li><h3>מבינים את הפניות</h3><p>מי פונה, באיזה ערוץ, מה חוזר על עצמו ואיפה היום נופלים פרטים.</p></li><li><h3>מגדירים את המענה</h3><p>מה לשאול, מה לא לומר, לאן להעביר ומתי אדם חייב להיכנס לתמונה.</p></li><li><h3>בודקים לפני שמחברים</h3><p>בוחנים תרחישים, טעויות והעברות. הפעלה בפועל מחייבת אישור והגדרות מתאימות.</p></li></ol>
  </div></section>
  <section class="page-section" style="background:var(--wash)"><div class="container reading prose"><h2>עסקים שונים. פניות שונות.</h2><p>אלו דוגמאות לתהליכים שאפשר לאפיין — לא רשימת התקנות קיימות או התחייבות ליכולת פעילה.</p>{trades.map((trade) => <article class="trade-detail" id={trade.id}><Picture name={trade.id} alt={`המחשה: ${trade.name}`} width={640} height={480} /><div><h3>{trade.name}</h3><p>{trade.text}</p></div></article>)}</div></section>
  <CTA />
</Layout>
