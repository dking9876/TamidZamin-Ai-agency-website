---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import Picture from '../../components/Picture.astro';
import CTA from '../../components/CTA.astro';
const trades = [
  { id: 'plumber', name: 'אינסטלטורים', text: 'כתובת, תיאור קצר של הבעיה ורמת הדחיפות — כדי להבין את הפנייה לפני שחוזרים ללקוח. איסוף המידע אינו אבחון מרחוק או הבטחה לטיפול חירום.' },
  { id: 'electrician', name: 'חשמלאים', text: 'קליטת בקשות שירות ואיסוף פרטי קשר. הסוכן אינו נותן הוראות עבודה בחשמל או הנחיות שעלולות לסכן את הפונה.' },
  { id: 'repair', name: 'טכנאי תיקונים', text: 'איזה ציוד דורש טיפול, מה הלקוח מתאר והיכן הוא נמצא. באפיון מחליטים אם לבקש גם תמונה בוואטסאפ, בהתאם לצורכי העסק.' },
  { id: 'hvac', name: 'טכנאי מיזוג', text: 'תיאור הבעיה במערכת המיזוג, סוג הציוד והכתובת. מידע ראשוני שמרכזים לקראת חזרה של בעל העסק או הצוות ללקוח, גם בתקופות עומס.' },
  { id: 'contractor', name: 'קבלנים ושיפוצניקים', text: 'תיאור העבודה המבוקשת, מיקום ופרטי קשר. הסיכום נועד לסייע בבירור אנושי מסודר; ההחלטות המקצועיות והצעת המחיר נשארות בידי העסק.' },
];
---
<Layout title="סוכני AI לעסקי שירות | אפיון, הקמה ותמיכה — TamidZamin" description="אפיון צורכי העסק, בניית סוכני AI ייעודיים בוואטסאפ ובטלפון, הקמה ותמיכה שוטפת. שירות לבעלי מקצוע בכל הארץ, עם היקף והצעה מותאמים לעסק.">
  <PageHeading title="מענה שמתאים לעבודה שלכם." description="מהיכרות עם צורכי העסק ועד סוכן ייעודי בוואטסאפ ובטלפון, הקמה ותמיכה שוטפת." />
  <section class="page-section"><div class="container">
    <div class="service-grid">
      <article class="service-detail"><Icon name="chat" size={36} /><h2>סוכן AI בוואטסאפ</h2><p>בונים שיחה כתובה שבה הלקוח יכול להסביר מה הוא צריך, להשלים פרטים ולאשר סיכום לקראת המשך טיפול.</p><ul><li>שיחה קצרה לפי צורכי העסק</li><li>איסוף מידע ותמונות לפי האפיון</li><li>הגדרת מצבים לטיפול של בעל העסק או הצוות</li></ul><a class="text-link" href="/services/whatsapp/">להכיר את התהליך <Icon name="arrow" size={18} /></a></article>
      <article class="service-detail"><Icon name="phone" size={36} /><h2>סוכן AI טלפוני</h2><p>בונים תהליך קולי למי שמעדיף להתקשר: הבנת הפנייה, איסוף המידע הנדרש וסיכום ברור לבעל העסק.</p><ul><li>קליטת סיבת הפנייה</li><li>בירור הפרטים והדחיפות</li><li>הקראת סיכום ואישורו</li></ul><a class="text-link" href="/services/phone/">להכיר את התהליך <Icon name="arrow" size={18} /></a></article>
    </div>
    <div class="notice"><strong>היקף שמתאים לעסק שלכם.</strong><p>השירות כולל אפיון, בניית סוכנים ייעודיים, הקמה ותמיכה שוטפת. את התכולה והיקף הליווי מסכמים יחד, והצעה מותאמת נמסרת לאחר היכרות עם הצרכים. המשך הטיפול בלקוחות נשאר בידי בעל העסק או הצוות שלו.</p></div>
    <h2>מההיכרות עם העסק — להקמה וליווי.</h2>
    <ol class="process"><li><h3>מכירים את העסק</h3><p>מבינים מי פונה, מה חוזר על עצמו ואילו פרטים נחוצים להמשך טיפול. יחד מגדירים את הצרכים והיקף השירות.</p></li><li><h3>בונים ומקימים</h3><p>בונים סוכן ייעודי, מגדירים את גבולות המענה ואת המשך הטיפול האנושי, ובודקים תרחישים לפני ההפעלה.</p></li><li><h3>מלווים גם בהמשך</h3><p>נותנים תמיכה שוטפת בהפעלת הסוכן ובוחנים התאמות לפי צורכי העסק והיקף הליווי שסוכם.</p></li></ol>
  </div></section>
  <section class="page-section" style="background:var(--wash)"><div class="container reading prose"><h2>עסקים שונים. פניות שונות.</h2><p>השירות מיועד לבעלי מקצוע ולעסקי שירות בכל הארץ, בדגש על אזור המרכז. הדוגמאות הבאות מציגות צרכים שאפשר להביא לאפיון, גם אם תחום העיסוק שלכם אינו מופיע כאן.</p>{trades.map((trade) => <article class="trade-detail" id={trade.id}><Picture name={trade.id} alt={`המחשה: ${trade.name}`} width={640} height={480} /><div><h3>{trade.name}</h3><p>{trade.text}</p></div></article>)}</div></section>
  <CTA />
</Layout>
