---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Picture from '../components/Picture.astro';
import CTA from '../components/CTA.astro';
import { site } from '../lib/site';
---
<Layout title="אודות TamidZamin | דניאל וייצר וסוכני AI לעסקים" description="הכירו את TamidZamin, המותג של דניאל וייצר לאפיון, הקמה ותמיכה בסוכני AI בוואטסאפ ובטלפון לעסקים ברחבי ישראל, בדגש על אזור המרכז.">
  <PageHeading title="AI לעסקים של אנשים." description="טכנולוגיה צריכה לפנות מקום לעבודה שלכם — לא להוסיף עוד מערכת שצריך לנהל." />
  <section class="page-section"><div class="container human-grid"><div class="prose"><h2>מתחילים במה שקורה ביום עבודה אמיתי.</h2><p>בעל מקצוע לא תמיד יכול להרים טלפון. לפעמים הוא באמצע תיקון, בדרך ללקוח או מסיים עבודה. באותו זמן, הפניות ממשיכות להגיע והפרטים מתפזרים בין שיחות והודעות.</p><p><bdi>{site.name}</bdi> הוא מותג עסקי שמפעיל {site.legalName}. השירות כולל היכרות עם צורכי העסק, בניית סוכני AI ייעודיים בוואטסאפ ובטלפון, הקמה ותמיכה שוטפת. הוא מיועד לבעלי מקצוע ולעסקי שירות בכל הארץ, בדגש על אזור המרכז.</p><p>נקודת ההתחלה היא תהליך העבודה שלכם: איזה מידע חסר, מה נדרש כדי לחזור ללקוח ומתי צריך אדם. כשפונים דרך האתר, מדברים ישירות עם {site.legalName} — לא עם סוכן אוטומטי.</p></div><Picture name="about" alt="תמונת המחשה של בעל מקצוע" width={960} height={720} /></div></section>
  <article class="container reading prose page-section"><h2>שלושה דברים שלא מתפשרים עליהם.</h2><h3>בהירות לפני הבטחות</h3><p>מגדירים מה הסוכן אמור לעשות, מה מחוץ לתפקידו ואיך בודקים את המענה. המטרה היא לרכז פניות בצורה מסודרת ולהקל על המשך הטיפול — בלי הבטחה לתוצאה עסקית מסוימת.</p><h3>האדם נשאר בתמונה</h3><p>הסוכן מסייע באיסוף ובסידור מידע. המשך הטיפול האנושי נעשה על ידי בעל העסק או הצוות שלו, וההחלטות המקצועיות נשארות בידיהם. התמיכה של <bdi>{site.name}</bdi> נוגעת לסוכן ולהפעלתו, ואינה מוקד שירות ללקוחות העסק.</p><h3>מגדירים לפני שמקימים</h3><p>מכירים את הצרכים, קובעים את גבולות המענה ובודקים תרחישים לפני ההפעלה. היקף ההקמה והתמיכה נקבע יחד, והצעה מותאמת נמסרת לאחר האפיון.</p><p><a href="/services/">קראו על השירותים והתהליך</a> או <a href={site.whatsappUrl}>כתבו ל{site.legalName} בוואטסאפ</a>.</p></article><CTA />
</Layout>
