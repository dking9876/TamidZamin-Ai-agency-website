---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CallDemo from '../components/CallDemo.astro';
import WhatsAppDemo from '../components/WhatsAppDemo.astro';
import { site } from '../lib/site';
import { demoContact } from '../lib/demo-contact';
const trades = [
  { name: 'plumber', label: 'אינסטלטורים', icon: 'wrench' as const },
  { name: 'electrician', label: 'חשמלאים', icon: 'bolt' as const },
  { name: 'repair', label: 'טכנאי תיקונים', icon: 'tools' as const },
  { name: 'hvac', label: 'טכנאי מיזוג', icon: 'fan' as const },
  { name: 'contractor', label: 'קבלנים ושיפוצניקים', icon: 'helmet' as const },
];
const benefits = [
  { icon: 'shield' as const, label: 'גבולות ברורים', text: 'לא מבטיחים מה שלא נבדק' },
  { icon: 'chat' as const, label: 'פנייה מסודרת', text: 'הפרטים במקום אחד' },
  { icon: 'target' as const, label: 'שאלות ממוקדות', text: 'אוספים את מה שצריך' },
  { icon: 'clock' as const, label: 'פחות התעסקות', text: 'זו המטרה, לא הבטחה' },
  { icon: 'user' as const, label: 'אדם בתמונה', text: 'החלטות מקצועיות אצלכם' },
];
---
<Layout title="TamidZamin | סוכני AI בוואטסאפ ובטלפון לעסקים בישראל" description="אפיון, בנייה והקמה של סוכני AI בוואטסאפ ובטלפון לעסקי שירות ובעלי מקצוע, עם תמיכה שוטפת. TamidZamin משרתת עסקים בכל ישראל, בדגש על המרכז.">
  <section class="home-hero" aria-labelledby="hero-title" data-motion="hero">
    <div class="hero-visual" aria-hidden="true">
      <picture>
        <source media="(max-width: 600px) and (orientation: portrait)" srcset="/media/hero-poster-mobile.webp" width="720" height="1280" />
        <img class="hero-poster" src="/media/hero-poster.webp" alt="" width="1280" height="720" fetchpriority="high" />
      </picture>
      <video id="hero-video" class="hero-video" data-src="/media/hero-film.mp4" data-mobile-src="/media/hero-film-mobile.mp4" width="1280" height="720" muted loop playsinline preload="none" tabindex="-1"></video>
    </div>
    <div class="container hero-content">
      <div class="home-hero-copy">
        <h1 id="hero-title"><span class="hero-title-line">כל פנייה מתחילה</span> <span class="hero-title-line hero-title-answer">במענה נכון.</span></h1>
        <div class="hero-actions"><a class="pill" href={site.whatsappUrl}>נדבר בוואטסאפ <Icon name="chat" size={16} /></a><a class="hero-secondary" href="#process">איך זה עובד <Icon name="arrow" size={16} /></a></div>
      </div>
    </div>
    <button class="hero-video-toggle" type="button" aria-controls="hero-video" aria-label="הפעלת סרטון הרקע" data-playing="false" hidden>
      <svg class="video-pause-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
      <svg class="video-play-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" /></svg>
      <span>הפעלת סרטון</span>
    </button>
    <span class="hero-video-status" role="status"></span>
  </section>

  <section class="home-channels blue-edge" id="channels" aria-label="פתרונות בוואטסאפ ובטלפון">
    <p class="home-intro container">סוכני AI בוואטסאפ ובטלפון לעסקי שירות. מאפיינים את הצרכים, בונים ומקימים סוכן ייעודי ומלווים אתכם בתמיכה שוטפת. ההחלטות המקצועיות נשארות אצלכם.</p>
    <div class="container channel-stage">
      <article class="home-channel whatsapp-channel" aria-labelledby="whatsapp-title">
        <h2 id="whatsapp-title"><Icon name="chat" size={30} />סוכן AI בוואטסאפ</h2>
        <WhatsAppDemo />
        <ul class="check-list"><li><Icon name="check" />אוסף פרטים בשיחה קצרה</li><li><Icon name="check" />מבקש תמונה כשצריך</li><li><Icon name="check" />מסכם ומאפשר תיקונים</li><li><Icon name="check" />מכין להמשך טיפול אנושי</li></ul>
        <a class="pill" href="/services/whatsapp/">להכיר את מענה הוואטסאפ <Icon name="arrow" size={15} /></a>
      </article>
      <div class="brand-connector" aria-hidden="true"><img src="/images/connector.webp" width="280" height="240" alt="" loading="lazy" /><img class="connector-logo" src="/images/icon.png" width="64" height="64" alt="" loading="lazy" /></div>
      <article class="home-channel phone-channel" aria-labelledby="phone-title">
        <h2 id="phone-title"><Icon name="phone" size={30} />סוכן AI טלפוני</h2>
        <CallDemo />
        <ul class="check-list"><li><Icon name="check" />מבין את סיבת הפנייה</li><li><Icon name="check" />אוסף פרטי קשר ודחיפות</li><li><Icon name="check" />מקריא סיכום לאישור</li><li><Icon name="check" />מעביר ליעד שסוכם ונבדק</li></ul>
        <a class="pill" href="/services/phone/">להכיר את המענה הטלפוני <Icon name="arrow" size={15} /></a>
      </article>
    </div>
    <div class="container demo-contact" aria-labelledby="demo-contact-title">
      <div>
        <h3 id="demo-contact-title">נסו בעצמכם את {demoContact.name}</h3>
        <p><bdi dir="ltr">{demoContact.phoneDisplay}</bdi></p>
        <p class="demo-contact-note">להתנסות, השתמשו בפרטים לדוגמה.</p>
      </div>
      <div class="demo-contact-actions">
        <a class="pill" href={demoContact.whatsappUrl}><Icon name="chat" size={19} />לנסות בוואטסאפ</a>
        <a class="pill pill-outline" href={demoContact.phoneUrl}><Icon name="phone" size={19} />להתקשר לסופר טריס</a>
      </div>
    </div>
  </section>

  <section class="home-process pale-waves" id="process">
    <div class="container"><h2>איך זה עובד?</h2><ol data-motion="handoff">
      <li><span class="step-icon"><Icon name="chat" size={31} /></span><h3>1. לקוח פונה</h3><p>כותב בוואטסאפ<br />או מתקשר לעסק.</p><span class="flow-line" aria-hidden="true"><span></span></span></li>
      <li><span class="step-icon"><Icon name="robot" size={31} /></span><h3>2. אוספים פרטים</h3><p>מבינים את הבקשה<br />ושואלים רק מה שחסר.</p><span class="flow-line" aria-hidden="true"><span></span></span></li>
      <li><span class="step-icon"><Icon name="list" size={31} /></span><h3>3. מאשרים סיכום</h3><p>הלקוח בודק את הפרטים<br />ומתקן במידת הצורך.</p><span class="flow-line" aria-hidden="true"><span></span></span></li>
      <li><span class="step-icon"><Icon name="user" size={31} /></span><h3>4. ממשיכים עם אדם</h3><p>בעל העסק או הצוות שלו<br />ממשיכים בטיפול לפי הצורך.</p></li>
    </ol></div>
  </section>

  <section class="home-trades" id="trades"><div class="container trade-strip">
    <div class="trade-intro"><h2>לעצמאים ולבעלי מקצוע<br /> <strong>בתחום השירות</strong></h2><p>מענה שמתחיל בהיכרות<br /> עם העבודה שלכם.</p></div>
    <div class="angled-trades">{trades.map(({ name, label, icon }) => <a class="angled-trade" href={`/services/#${name}`}><Picture name={name} alt={`המחשה של ${label} בעבודה`} width={640} height={480} /><span class="trade-icon"><Icon name={icon} size={25} /></span><h3>{label}</h3></a>)}</div>
  </div></section>

  <section class="home-benefits pale-waves" id="benefits"><div class="container benefits-strip"><h2>מה חשוב לנו<br /> במענה שלכם?</h2><ul>{benefits.map((item) => <li><Icon name={item.icon} size={34} /><h3>{item.label}</h3><p>{item.text}</p></li>)}</ul></div></section>

  <section class="home-human blue-edge" id="human"><div class="container human-strip">
    <div class="human-intro"><h2>טכנולוגיה שעוזרת.<br />אנשים שלוקחים אחריות.</h2><p>מגדירים מראש מה הסוכן שואל,<br class="desktop-break" /> מה הוא לא יודע ומתי עוברים לאדם.</p><a class="text-link" href="/services/">על התהליך והגבולות <Icon name="arrow" size={18} /></a></div>
    <Picture name="support" alt="תמונת המחשה של אשת שירות עם אוזנייה" width={960} height={540} />
    <div class="handoff-art" aria-hidden="true"><span><Icon name="robot" size={44} /></span><Icon name="arrow" size={35} /><span><Icon name="user" size={44} /></span></div>
  </div></section>

  <section class="home-about pale-waves" id="about"><div class="container about-strip">
    <div class="about-intro"><h2>השותף הטכנולוגי<br />לעסק העצמאי שלכם.</h2><p><bdi>TamidZamin</bdi> מלווה עסקי שירות<br class="desktop-break" /> בכל ישראל, בדגש על המרכז —<br class="desktop-break" /> מהיכרות עם העסק ועד תמיכה שוטפת.</p><a class="text-link" href="/about/">עוד על TamidZamin <Icon name="arrow" size={17} /></a></div>
    <ul><li><Icon name="target" size={28} /><div><h3>מתחילים מהעסק שלכם</h3><p>מבינים את הפניות ואת דרך העבודה.</p></div></li><li><Icon name="shield" size={28} /><div><h3>ברור מה כן ומה לא</h3><p>בלי מחירים או יכולות מומצאים.</p></div></li><li><Icon name="user" size={28} /><div><h3>האדם נשאר בתמונה</h3><p>החלטות מקצועיות נשארות אצלכם.</p></div></li></ul>
    <div class="about-photo" data-motion="photo"><Picture name="about" alt="תמונת המחשה של בעל מקצוע ליד בית לקוח" width={960} height={720} /></div>
  </div></section>

  <section class="home-evidence blue-edge" id="evidence"><div class="container evidence-strip"><h2>מה אפשר ללמוד<br />מההדגמות?</h2><p><Icon name="list" size={48} /><strong>דוגמה: קליטת פניות לתריסים חשמליים</strong><br />איסוף פרטים, אישור סיכום והכנה לטיפול אנושי.<br />הדגמה מוקלטת, לא שירות פעיל באתר.</p><a class="pill pill-outline" href="/services/whatsapp/">על תהליך העבודה וההדגמה <Icon name="arrow" size={17} /></a></div><p class="demo-disclosure container">השיחות מבוימות ואינן עדות לקוח. לא מתבצעים דרכן אבחון, מסירת מחיר, קביעת תור או תשלום.</p></section>

  <section class="home-faq pale-waves" id="faq"><div class="container faq-strip"><h2>שאלות<br /> נפוצות</h2><FAQ all /></div></section>
  <section class="home-close blue-edge" id="contact"><div class="container close-strip"><div><h2>בואו נעשה סדר בפניות לעסק.</h2><p>נכיר את העבודה שלכם ונבדוק אם סוכן AI מתאים לכם.</p></div><a class="pill" href={site.whatsappUrl}>נדבר בוואטסאפ <Icon name="chat" size={18} /></a></div></section>
  <script>
    import '../scripts/home-motion';
    import '../scripts/hero-video';
    import '../scripts/call-demo';
    import '../scripts/whatsapp-demo';
  </script>
</Layout>
