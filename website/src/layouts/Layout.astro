---
import '@fontsource-variable/heebo';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/navigation.css';
import '../styles/hero.css';
import Picture from '../components/Picture.astro';
import Navigation from '../components/Navigation.astro';
import { site } from '../lib/site';
import { mainLinks, serviceLinks, utilityLinks, contactLink } from '../lib/navigation';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.origin).href;
const indexable = site.launched && !noindex;
const path = Astro.url.pathname;
const footerGroups = [
  { label: 'פתרונות לעסק', links: serviceLinks },
  { label: 'TamidZamin', links: [...mainLinks, contactLink] },
  { label: 'מידע שימושי', links: utilityLinks },
];
const organizationId = `${site.origin}/#organization`;
const websiteId = `${site.origin}/#website`;
const pageLabel = [...mainLinks, ...serviceLinks, contactLink, ...utilityLinks].find((link) => link.href === path)?.label;
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'עמוד הבית', item: `${site.origin}/` },
  ...(path.startsWith('/services/') && path !== '/services/'
    ? [{ '@type': 'ListItem', position: 2, name: 'השירותים שלנו', item: `${site.origin}/services/` }] : []),
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': organizationId,
      name: site.name, url: site.origin, logo: new URL('/images/logo-600.webp', site.origin).href,
      description: 'אפיון, בנייה והקמה של סוכני AI בוואטסאפ ובטלפון לעסקי שירות בישראל, עם תמיכה שוטפת.',
      email: site.email, telephone: site.phone,
      areaServed: { '@type': 'Country', name: 'Israel' },
      contactPoint: { '@type': 'ContactPoint', name: site.legalName, telephone: site.phone, email: site.email, contactType: 'customer inquiries' },
    },
    { '@type': 'WebSite', '@id': websiteId, name: site.name, url: `${site.origin}/`, inLanguage: 'he', publisher: { '@id': organizationId } },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'he', isPartOf: { '@id': websiteId } },
    ...(path.startsWith('/services/') ? [{
      '@type': 'Service', '@id': `${canonical}#service`, name: title.split(' | ')[0],
      description, url: canonical, provider: { '@id': organizationId }, areaServed: { '@type': 'Country', name: 'Israel' },
    }] : []),
    ...(path !== '/' && pageLabel ? [{
      '@type': 'BreadcrumbList',
      itemListElement: [...breadcrumbItems, { '@type': 'ListItem', position: breadcrumbItems.length + 1, name: pageLabel, item: canonical }],
    }] : []),
  ],
};
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#08162c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <link rel="apple-touch-icon" href="/images/icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="TamidZamin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/social.jpg', site.origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="המחשה של בעל מקצוע בעבודה — TamidZamin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/social.jpg', site.origin).href} />
    {indexable && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  </head>
  <body class={path === '/' ? 'homepage' : undefined}>
    <a class="skip-link" href="#main">דלגו לתוכן הראשי</a>
    <Navigation />
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="TamidZamin — לעמוד הבית"><Picture name="logo" alt="TamidZamin" width={600} height={146} /></a>
          <p>סוכני AI לעסקים של אנשים.</p>
          <div class="footer-contact">
            <a href={site.whatsappUrl}>דברו איתנו בוואטסאפ</a>
            <a href={site.phoneUrl}><bdi>{site.phoneDisplay}</bdi></a>
            <span>מפעיל האתר: {site.legalName}</span>
          </div>
        </div>
        {footerGroups.map((group) => (
          <nav aria-label={`ניווט תחתון — ${group.label}`}>
            <h2 class="footer-nav-title">{group.label}</h2>
            {group.links.map((link) => <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>)}
          </nav>
        ))}
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} <bdi>TamidZamin</bdi></span>
        <span>התמונות והשיחות באתר הן להמחשה.</span>
        {!site.launched && <span class="preview-label">תצוגה מקדימה · אינה מיועדת לאינדוקס</span>}
      </div>
    </footer>
  </body>
</html>
<style>
  .footer-contact { display: grid; justify-items: start; gap: 8px; margin-block-start: 18px; font-size: 14px; }
  .footer-contact a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
