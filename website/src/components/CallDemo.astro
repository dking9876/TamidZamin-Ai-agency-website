---
import Icon from './Icon.astro';
import CallSummary from './CallSummary.astro';
import transcript from '../data/call-transcript.json';
import { formatCallTime } from '../lib/call-transcript';
---
<figure class="device-stage call-demo" id="phone-demo" data-motion="devices">
  <div class="phone-shell voice-phone recording-phone" data-state="idle" data-view="call">
    <div class="recording-heading">
      <span class="recording-call-icon"><Icon name="phone" size={26} /></span>
      <span class="recording-owner-icon"><Icon name="chat" size={26} /></span>
      <div><strong dir="ltr">TamidZamin AI</strong><span class="recording-description">שיחת הדגמה מוקלטת</span></div>
    </div>
    <div class="recording-transcript" role="region" aria-label="תמליל שיחת ההדגמה" tabindex="0">
      <ol id="call-transcript-list">
        {transcript.map((cue, index) => (
          <li class="transcript-cue" data-cue={index} data-speaker={cue.speaker}>
            <div class="transcript-meta"><strong>{cue.speaker === 'agent' ? 'הסוכן' : 'הלקוח'}</strong><span dir="ltr">{formatCallTime(cue.start)}</span></div>
            <p>{cue.text}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="recording-summary" role="region" aria-label="הסיכום בוואטסאפ של בעל העסק" tabindex="0" hidden>
      <CallSummary replay />
    </div>
    <span class="recording-summary-announcement" role="status" aria-atomic="true"></span>
    <div class="transcript-follow-row" hidden>
      <span class="transcript-follow-note"><Icon name="check" size={14} />התמליל עוקב אחרי השיחה</span>
      <button class="recording-follow" type="button" aria-controls="call-transcript-list" hidden><Icon name="replay" size={15} />חזרה לשיחה</button>
    </div>
    <button class="recording-toggle" type="button" aria-controls="demo-call-audio" aria-label="לחצו להאזנה לשיחת ההדגמה" hidden>
      <span class="recording-play" aria-hidden="true">
        <svg class="recording-play-icon" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="m9 5 10 7-10 7V5Z" /></svg>
        <svg class="recording-pause-icon" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M8 5v14M16 5v14" /></svg>
      </span>
      <span class="recording-action">לחצו להאזנה</span>
      <span class="waveform" aria-hidden="true">
        {[12, 22, 36, 18, 48, 30, 55, 25, 43, 22, 36, 14, 26].map((height, index) =>
          <i style={`height:${height}px;--beat-delay:${index * -90}ms`} />)}
      </span>
    </button>
    <div class="recording-controls" hidden>
      <div class="recording-time" dir="ltr" aria-hidden="true"><span class="recording-elapsed">0:00</span><span class="recording-duration">2:15</span></div>
      <input class="recording-seek" type="range" min="0" max="135" value="0" step="0.1" dir="ltr" aria-label="מיקום בשיחת ההדגמה" aria-valuetext="0:00 מתוך 2:15" aria-controls="demo-call-audio" disabled />
      <div class="recording-actions">
        <button class="recording-sound" type="button" aria-controls="demo-call-audio" aria-label="השתקת קול בשיחת ההדגמה" data-muted="false">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 5-6 4H2v6h3l6 4V5Z" /><path class="sound-on" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /><path class="sound-off" d="m16 9 6 6m0-6-6 6" /></svg>
          <span>השתקת קול</span>
        </button>
        <button class="recording-restart" type="button" aria-controls="demo-call-audio"><Icon name="replay" size={16} /><span>מההתחלה</span></button>
      </div>
    </div>
    <!-- Inline video supports muted autoplay of this unchanged audio-only file. -->
    <video id="demo-call-audio" src="/media/demo-call.mp3" preload="none" playsinline controls aria-label="הקלטת שיחת ההדגמה של TamidZamin"></video>
  </div>
  <figcaption class="device-caption recording-caption">
    <span class="recording-status" role="status" aria-atomic="true"></span>
    <a class="recording-download" href="/media/demo-call.mp3" hidden>פתיחת ההקלטה ישירות</a>
    <noscript><a class="recording-download" href="/media/demo-call.mp3">פתיחת ההקלטה ישירות</a></noscript>
  </figcaption>
  <noscript>
    <details class="recording-summary-fallback">
      <summary>הסיכום שבעל העסק מקבל בוואטסאפ</summary>
      <CallSummary />
    </details>
  </noscript>
</figure>

<style>
  .device-stage .recording-phone {
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  .recording-phone > :not(.recording-transcript, .recording-summary) { flex-shrink: 0; }
  .recording-heading { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 28px 12px 20px; }
  .recording-heading > span { color: var(--cyan); flex-shrink: 0; display: flex; }
  .recording-heading > span svg { width: 22px; }
  .recording-heading .recording-owner-icon, [data-view="summary"] .recording-call-icon { display: none; }
  [data-view="summary"] .recording-owner-icon { display: flex; color: #72dba8; }
  .recording-heading strong { display: block; font-size: 1rem; overflow-wrap: anywhere; }
  .recording-description { display: block; font-size: .875rem; color: var(--on-dark); margin-block-start: 4px; }
  .recording-transcript {
    flex: 1;
    min-height: 8rem;
    overflow: auto;
    padding: 12px;
    text-align: start;
    border-block: 1px solid #244359;
    scrollbar-width: thin;
    scrollbar-color: #527d99 #06101b;
    scroll-padding-block: 12px;
  }
  .recording-transcript:focus-visible { outline-offset: -3px; }
  .recording-summary { flex: 1; min-height: 8rem; overflow: auto; padding: 12px; background: #efeae2; scrollbar-width: thin; scrollbar-color: #698477 #efeae2; scroll-padding-block: 12px; }
  .recording-summary:focus-visible { outline: 2px solid #207b56; outline-offset: -3px; }
  .recording-summary-announcement { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  [data-view="summary"] .recording-heading { padding-block: 18px 14px; }
  [data-view="summary"] .recording-toggle { min-height: 44px; }
  [data-view="summary"] .recording-toggle .waveform,
  [data-view="summary"] .recording-time,
  [data-view="summary"] .recording-actions { display: none; }
  .recording-summary-fallback { margin-block-start: 16px; text-align: start; }
  .recording-summary-fallback > summary { min-height: 44px; padding-block: 10px; color: var(--cyan); cursor: pointer; }
  .recording-summary-fallback[open] { padding: 12px; background: #efeae2; border-radius: 9px; }
  .recording-summary-fallback[open] > summary { color: #207b56; }
  .recording-transcript ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .transcript-cue { min-width: 0; margin-inline-end: 10px; padding: 10px; border: 1px solid transparent; border-radius: 10px 10px 3px 10px; background: #102340; }
  .transcript-cue[data-speaker="customer"] { margin-inline: 10px 0; border-radius: 10px 10px 10px 3px; background: #0c202e; }
  .transcript-cue[aria-current="true"] { border-color: var(--cyan); background: #123451; }
  .transcript-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; font-size: .75rem; color: var(--on-dark); font-variant-numeric: tabular-nums; }
  .transcript-meta strong { color: var(--cyan); font-weight: 650; }
  .transcript-cue[data-speaker="customer"] .transcript-meta strong { color: var(--paper); }
  .recording-transcript .transcript-cue p { margin: 6px 0 0; font-size: .875rem; line-height: 1.65; color: var(--paper); overflow-wrap: anywhere; }
  .recording-transcript ::selection { color: var(--navy-deep); background: var(--cyan); }
  .transcript-follow-row { min-height: 44px; display: grid; place-items: center; padding-inline: 8px; }
  .transcript-follow-note { display: flex; align-items: center; gap: 6px; font-size: .75rem; color: var(--on-dark); }
  .transcript-follow-note svg { flex-shrink: 0; color: var(--cyan); }
  .recording-follow { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 8px; border: 0; border-radius: 6px; color: var(--cyan); background: transparent; font-size: .8125rem; cursor: pointer; }
  .recording-follow:is(:hover, :focus-visible) { background: #ffffff0d; color: var(--paper); }
  .recording-toggle {
    width: calc(100% - 24px);
    margin-inline: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 64px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: var(--paper);
    cursor: pointer;
    font: inherit;
  }
  .device-stage .recording-toggle .waveform { width: 36px; height: 24px; gap: 2px; margin: 0; flex-shrink: 0; margin-inline-start: auto; overflow: hidden; }
  .device-stage .recording-toggle .waveform i { max-height: 22px; width: 2px; }
  .recording-play {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--pill-paper);
    color: var(--pill-ink);
    transition: background-color var(--motion-feedback) ease-out;
  }
  .recording-toggle:is(:hover, :focus-visible) .recording-play { background: var(--cyan); }
  .recording-toggle:focus-visible { outline-offset: 3px; border-radius: 6px; }
  .recording-action { font-size: .875rem; font-weight: 650; text-align: start; }
  .recording-pause-icon,
  [data-state="playing"] .recording-play-icon,
  [data-state="loading"] .recording-play-icon { display: none; }
  [data-state="playing"] .recording-pause-icon,
  [data-state="loading"] .recording-pause-icon { display: block; }
  [data-state="playing"] .waveform i { animation: call-wave 850ms ease-in-out var(--beat-delay) infinite alternate; }
  [data-state="loading"] .waveform { opacity: .5; }
  .recording-controls { padding: 4px 16px 8px; }
  .recording-time { display: flex; justify-content: space-between; gap: 12px; font-size: .8125rem; color: var(--on-dark); font-variant-numeric: tabular-nums; }
  .recording-seek {
    display: block;
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    accent-color: var(--cyan);
    cursor: pointer;
  }
  .recording-seek:disabled { opacity: .55; cursor: default; }
  .recording-seek:focus-visible { outline-color: var(--cyan); outline-offset: 0; }
  .recording-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .recording-restart, .recording-sound {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 12px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--on-dark);
    font-size: .8125rem;
    cursor: pointer;
  }
  .recording-restart:is(:hover, :focus-visible), .recording-sound:is(:hover, :focus-visible) { color: var(--paper); background: #ffffff0d; }
  .recording-sound { color: var(--cyan); }
  .recording-sound[data-muted="true"] { background: var(--pill-paper); color: var(--pill-ink); }
  .recording-sound[data-muted="true"]:is(:hover, :focus-visible) { background: var(--pill-hover); color: var(--pill-ink); }
  .recording-sound .sound-off, .recording-sound[data-muted="true"] .sound-on { display: none; }
  .recording-sound[data-muted="true"] .sound-off { display: block; }
  .recording-caption { grid-template-rows: auto; font-size: .8125rem; }
  .recording-caption:not(:has(.recording-status:not(:empty), .recording-download:not([hidden]))) { margin-block-start: 0; }
  .recording-status:empty { display: none; }
  .recording-status { color: var(--paper); }
  .recording-download { display: inline-flex; align-items: center; min-height: 44px; color: var(--cyan); text-underline-offset: .25em; }
  #demo-call-audio { width: 100%; height: 54px; margin-block: 24px; }
  .call-demo [hidden] { display: none; }
  @keyframes call-wave { from { transform: scaleY(.35); } to { transform: scaleY(1); } }
  @media (max-width: 880px) {
    .recording-heading strong { font-size: 1.125rem; }
    .recording-transcript .transcript-cue p { font-size: .9375rem; }
    .recording-time, .recording-restart, .recording-sound { font-size: .875rem; }
  }
  @media (min-width: 881px) and (max-width: 1100px) {
    .recording-heading { flex-direction: column; gap: 8px; }
    .recording-transcript { padding-inline: 8px; }
    .transcript-cue { margin-inline-end: 0; padding: 8px; }
    .transcript-cue[data-speaker="customer"] { margin-inline: 0; }
    .device-stage .recording-toggle .waveform { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-state="playing"] .waveform i { animation: none; }
  }
</style>
