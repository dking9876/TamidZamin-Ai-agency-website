---
import Icon from './Icon.astro';
---
<figure class="device-stage whatsapp-demo" id="whatsapp-demo" data-motion="devices" data-state="idle">
  <div class="phone-shell whatsapp-phone">
    <video id="demo-whatsapp-video" src="/media/demo-whatsapp-3x.mp4" poster="/media/demo-whatsapp-poster.webp" width="720" height="1600" preload="none" muted playsinline controls aria-label="הקלטת הדגמת וואטסאפ במהירות פי שלושה"></video>
  </div>
  <figcaption class="device-caption whatsapp-caption">
    <div class="whatsapp-controls" hidden>
      <div class="whatsapp-toolbar">
        <button class="whatsapp-toggle" type="button" aria-controls="demo-whatsapp-video" aria-label="צפייה בהדגמת הוואטסאפ">
          <svg class="whatsapp-play-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 10 7-10 7V5Z" /></svg>
          <svg class="whatsapp-pause-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
          <span class="whatsapp-action">לצפייה בדמו</span>
        </button>
        <button class="whatsapp-restart" type="button" aria-controls="demo-whatsapp-video" aria-label="הדגמת הוואטסאפ מההתחלה" title="מההתחלה"><Icon name="replay" size={19} /></button>
        <button class="whatsapp-fullscreen" type="button" aria-controls="demo-whatsapp-video" aria-label="הגדלת הדגמת הוואטסאפ למסך מלא" title="מסך מלא" hidden>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg>
        </button>
      </div>
      <input class="whatsapp-seek" type="range" min="0" max="45.708333" value="0" step="0.1" dir="ltr" aria-label="מיקום בהדגמת הוואטסאפ" aria-valuetext="0:00 מתוך 0:45" aria-controls="demo-whatsapp-video" disabled />
      <div class="whatsapp-meta"><span>מהירות <bdi>3×</bdi></span><span class="whatsapp-time" dir="ltr" aria-hidden="true"><span class="whatsapp-elapsed">0:00</span> / <span class="whatsapp-duration">0:45</span></span></div>
    </div>
    <span class="whatsapp-status" role="status" aria-atomic="true"></span>
    <a class="whatsapp-download" href="/media/demo-whatsapp-3x.mp4" hidden>פתיחת הסרטון ישירות</a>
    <noscript><span>מהירות פי 3 · כ־46 שניות</span><a class="whatsapp-download" href="/media/demo-whatsapp-3x.mp4">פתיחת הסרטון ישירות</a></noscript>
  </figcaption>
</figure>

<style>
  .device-stage .whatsapp-phone { background: #0b141a; }
  .device-stage .whatsapp-phone::after { display: none; }
  .whatsapp-phone video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; background: #0b141a; }
  .whatsapp-phone video:fullscreen { width: 100%; height: 100%; border-radius: 0; }
  .whatsapp-caption { grid-template-rows: auto; gap: 12px; font-size: .8125rem; }
  .whatsapp-controls { width: 100%; }
  .whatsapp-toolbar { display: flex; align-items: center; gap: 4px; }
  .whatsapp-toolbar button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 44px; min-height: 44px; padding: 8px; border: 0; border-radius: 6px; background: transparent; color: var(--on-dark); cursor: pointer; }
  .whatsapp-toolbar svg { flex-shrink: 0; }
  .whatsapp-toolbar .whatsapp-toggle { flex: 1; background: var(--pill-paper); color: var(--pill-ink); font-size: .875rem; font-weight: 650; }
  .whatsapp-toolbar button:is(:hover, :focus-visible) { background: var(--pill-outline-hover); color: var(--paper); }
  .whatsapp-toolbar .whatsapp-toggle:is(:hover, :focus-visible) { background: var(--pill-hover); color: var(--pill-ink); }
  .whatsapp-pause-icon,
  [data-state="playing"] .whatsapp-play-icon,
  [data-state="loading"] .whatsapp-play-icon { display: none; }
  [data-state="playing"] .whatsapp-pause-icon,
  [data-state="loading"] .whatsapp-pause-icon { display: block; }
  .whatsapp-seek { display: block; width: 100%; min-height: 44px; margin: 0; padding: 0; border: 0; background: transparent; accent-color: var(--cyan); cursor: pointer; }
  .whatsapp-seek:disabled { opacity: .55; cursor: default; }
  .whatsapp-seek:focus-visible { outline-offset: 0; }
  .whatsapp-meta { display: flex; justify-content: space-between; gap: 12px; font-size: .8125rem; }
  .whatsapp-time { font-variant-numeric: tabular-nums; }
  .whatsapp-status:empty { display: none; }
  .whatsapp-status { color: var(--paper); }
  .whatsapp-download { display: inline-flex; align-items: center; min-height: 44px; color: var(--cyan); text-underline-offset: .25em; }
  .whatsapp-demo [hidden] { display: none; }
</style>
