---
interface Props { title: string; description?: string; parent?: { href: string; label: string }; }
const { title, description, parent } = Astro.props;
---
<header class="page-heading"><div class="container"><nav class="breadcrumbs" aria-label="מיקום באתר"><a href="/">ראשי</a><span aria-hidden="true">/</span>{parent && <><a href={parent.href}>{parent.label}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{title}</span></nav><h1>{title}</h1>{description && <p>{description}</p>}</div></header>
