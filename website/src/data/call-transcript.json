[
  { "start": 0.27, "end": 0.74, "speaker": "agent", "turn": 0, "text": "הלו?" },
  { "start": 2.03, "end": 3.21, "speaker": "customer", "turn": 1, "text": "שלום, מה נשמע?" },
  { "start": 4.36, "end": 6.36, "speaker": "agent", "turn": 2, "text": "שלום, הגעתם לתריס מאסטר." },
  { "start": 6.60, "end": 8.50, "speaker": "agent", "turn": 2, "text": "אני העוזר הדיגיטלי של העסק." },
  { "start": 8.76, "end": 9.74, "speaker": "agent", "turn": 2, "text": "איך אפשר לעזור?" },
  { "start": 11.47, "end": 12.78, "speaker": "customer", "turn": 3, "text": "היי, התריס שלי התקלקל." },
  { "start": 12.78, "end": 15.20, "speaker": "customer", "turn": 3, "text": "הוא לא עולה ולא יורד. הוא תקוע." },
  { "start": 17.79, "end": 19.94, "speaker": "agent", "turn": 4, "text": "רק רגע. מצטער לשמוע." },
  { "start": 20.11, "end": 21.98, "speaker": "agent", "turn": 4, "text": "בשביל לפתוח בקשה לטכנאי," },
  { "start": 22.08, "end": 23.44, "speaker": "agent", "turn": 4, "text": "מה השם, בבקשה?" },
  { "start": 24.85, "end": 26.25, "speaker": "customer", "turn": 5, "text": "דניאל ויצר." },
  { "start": 27.37, "end": 28.75, "speaker": "agent", "turn": 6, "text": "תודה, דניאל ויצר." },
  { "start": 28.93, "end": 30.12, "speaker": "agent", "turn": 6, "text": "מה הכתובת לביקור?" },
  { "start": 30.35, "end": 32.32, "speaker": "agent", "turn": 6, "text": "עיר, רחוב ומספר בית." },
  { "start": 34.07, "end": 36.20, "speaker": "customer", "turn": 7, "text": "אה, שלמה שמונה עשרה, תל אביב." },
  { "start": 37.45, "end": 40.36, "speaker": "agent", "turn": 8, "text": "הבנתי, תל אביב, שלמה 18." },
  { "start": 40.81, "end": 43.34, "speaker": "agent", "turn": 8, "text": "האם יש קומה או דירה שצריך לציין?" },
  { "start": 45.13, "end": 46.18, "speaker": "customer", "turn": 9, "text": "לא, זה בית פרטי." },
  { "start": 47.14, "end": 49.36, "speaker": "agent", "turn": 10, "text": "בסדר. עד כמה הנושא דחוף?" },
  { "start": 51.06, "end": 52.77, "speaker": "customer", "turn": 11, "text": "אז הקלה ממש ממש דחופה." },
  { "start": 52.80, "end": 54.28, "speaker": "customer", "turn": 11, "text": "אני לא מצליח לצאת החוצה." },
  { "start": 56.11, "end": 58.72, "speaker": "agent", "turn": 12, "text": "הבנתי. מתי נוח לטכנאי להגיע?" },
  { "start": 58.83, "end": 62.20, "speaker": "agent", "turn": 12, "text": "אפשר לציין תאריך ושעה, או לומר שאין העדפה." },
  { "start": 64.26, "end": 65.64, "speaker": "customer", "turn": 13, "text": "אה, אני אשמח שהוא יגיע מחר." },
  { "start": 65.64, "end": 66.79, "speaker": "customer", "turn": 13, "text": "אני פנוי כל היום." },
  { "start": 67.95, "end": 72.73, "speaker": "agent", "turn": 14, "text": "מחר זה יום חמישי, 19 בנובמבר 2026, כל היום." },
  { "start": 73.22, "end": 75.43, "speaker": "agent", "turn": 14, "text": "האם תריס מאסטר רשאי ליצור איתכם קשר" },
  { "start": 75.43, "end": 77.11, "speaker": "agent", "turn": 14, "text": "במספר שמנו אתכם כעת?" },
  { "start": 78.34, "end": 80.43, "speaker": "customer", "turn": 15, "text": "כי אני אשמח שיתקשר אליי דרך המספר הזה." },
  { "start": 81.40, "end": 82.43, "speaker": "customer", "turn": 15, "text": "אוי אוי, שלח לי הודעה." },
  { "start": 84.54, "end": 87.69, "speaker": "agent", "turn": 16, "text": "הבנתי, נשתמש במספר שממנו אתם מתקשרים." },
  { "start": 88.04, "end": 90.05, "speaker": "agent", "turn": 16, "text": "לפני השליחה, אני חוזר על הפרטים:" },
  { "start": 90.47, "end": 92.08, "speaker": "agent", "turn": 16, "text": "השם דניאל ויצר," },
  { "start": 92.27, "end": 96.05, "speaker": "agent", "turn": 16, "text": "הכתובת תל אביב, שלמה 18, בית פרטי." },
  { "start": 96.61, "end": 99.90, "speaker": "agent", "turn": 16, "text": "התריס התקלקל, הוא לא עולה ולא יורד והוא תקוע." },
  { "start": 100.36, "end": 101.96, "speaker": "agent", "turn": 16, "text": "הדחיפות לפי מה שאמרתם:" },
  { "start": 101.99, "end": 103.82, "speaker": "agent", "turn": 16, "text": "הקלה ממש ממש דחופה," },
  { "start": 104.05, "end": 105.54, "speaker": "agent", "turn": 16, "text": "אני לא מצליח לצאת החוצה." },
  { "start": 106.04, "end": 108.39, "speaker": "agent", "turn": 16, "text": "הביקור המבוקש מחר, יום חמישי," },
  { "start": 108.46, "end": 110.29, "speaker": "agent", "turn": 16, "text": "19 בנובמבר, כל היום." },
  { "start": 110.77, "end": 113.68, "speaker": "agent", "turn": 16, "text": "הטכנאי יחזור אליכם במספר שממנו אתם מתקשרים." },
  { "start": 113.97, "end": 115.12, "speaker": "agent", "turn": 16, "text": "האם הפרטים נכונים?" },
  { "start": 116.77, "end": 118.08, "speaker": "customer", "turn": 17, "text": "כן, המוגנים יכולים." },
  { "start": 121.11, "end": 123.00, "speaker": "agent", "turn": 18, "text": "רק רגע. הבקשה התקבלה." },
  { "start": 123.21, "end": 125.60, "speaker": "agent", "turn": 18, "text": "נציג יחזור אליכם כדי לתאם את הביקור." },
  { "start": 125.96, "end": 127.80, "speaker": "agent", "turn": 18, "text": "יש עוד משהו שאפשר לעזור בו?" },
  { "start": 129.07, "end": 129.98, "speaker": "customer", "turn": 19, "text": "לא, תודה רבה." },
  { "start": 131.75, "end": 134.35, "speaker": "agent", "turn": 20, "text": "תודה שפניתם לתריס מאסטר. להתראות." }
]
