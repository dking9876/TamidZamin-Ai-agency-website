# Runtime environment for the dedicated Node server. Never put these secrets in
# PUBLIC_* variables or client scripts. This example intentionally cannot deliver.
# Production Node must receive these through its environment or --env-file.
# On Vercel, leave SITE_URL unset for the first preview rather than using this
# placeholder. The adapter is detected automatically. Delivery remains blocked:
# local SQLite is not a persistent/shared store in Vercel Functions.
SITE_URL=https://example.invalid
SITE_LAUNCHED=false
PUBLIC_CONTACT_EMAIL=
PUBLIC_PHONE=
PUBLIC_WHATSAPP=
PUBLIC_BOOKING_URL=
PUBLIC_LEGAL_NAME=

# Explicit opt-in only AFTER operator approval and receiver/security/legal review.
LEAD_DELIVERY_ENABLED=false
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
FORM_SECRET=
# FORM_SECRET: generate >=32 random characters; rotation invalidates open forms.
# Webhook: HTTPS JSON POST, Authorization: Bearer <LEAD_WEBHOOK_TOKEN>.
# Success requires HTTP 2xx AND application/json containing {"accepted":true}.
# Receiver must durably accept/enqueue before confirming and deduplicate the
# Idempotency-Key header/requestId for at least 7 days. Never auto-retry unknowns.
# Optional receiver reference is not displayed or persisted; local requestId is
# the visitor's reference. Acceptance is NOT an appointment or human follow-up.
LEAD_WEBHOOK_TIMEOUT_MS=8000

# REQUIRED absolute path to a PRIVATE, persistent writable directory outside the
# web root. Example Windows: C:/ProgramData/TamidZamin/leads ; Linux: /var/lib/tamidzamin
# One dedicated Node deployment on a local persistent disk. Not serverless,
# ephemeral containers, network-mounted SQLite, or multi-host replicas.
DATA_DIR=
# SQLite stores only HMAC IP/rate buckets and HMAC lead fingerprints with receipt
# id/status/timestamps; no name, phone, email, business or message content.
# Rate windows: 12 attempts/IP and 200 total per 15 minutes. Receipt cap: 10,000.
# Rate rows expire each 15-minute window; receipts after 7 days. Bounded pruning
# runs on intake; expired records may remain while idle until the next request.
# No automatic backups are made. Operator must agree retention/deletion policy,
# permissions (Windows ACLs in particular), disk monitoring and receiver retention.

# Ignore all X-Forwarded-For headers by default. If enabled, provide exact IPs of
# ONLY controlled reverse proxies (comma-separated IP literals, no CIDR). Restrict
# direct origin access; proxy must sanitize/overwrite forwarding headers. The
# server walks the chain from the trusted socket peer, never trusts the leftmost
# value blindly. Do not use untrusted adapter middleware to replace clientAddress.
# Astro 7.4 / Node 11: keep security.allowedDomains empty (it otherwise lets
# forwarded headers replace clientAddress). Parent must disable Astro's separate
# checkOrigin guard for this site's sole write route; our endpoint always checks
# Origin against SITE_URL itself. See src/server/README.md for the exact rationale.
LEAD_TRUST_PROXY=false
LEAD_PROXY_IPS=

# Local mock ONLY: also requires NODE_ENV=development. Has no effect in production.
# This allows HTTP only for localhost/127.0.0.1/[::1], not arbitrary HTTP endpoints.
LEAD_ALLOW_INSECURE_LOCALHOST=false
# All launch details remain unconfigured. Do not publish or send real leads until
# an authorized operator explicitly configures and approves production delivery.

# Explicit launch approvals checked by verify:launch. Keep false until approved.
LEGAL_REVIEW_APPROVED=false
CAPABILITIES_APPROVED=false
ASSET_RIGHTS_CONFIRMED=false
LAUNCH_APPROVED=false
