# Public website configuration. No credentials are needed for direct contact.
# Approved identity/contact defaults live in src/data/business.json.
# Do not commit .env. Set launch values on Vercel's Production target ONLY.
SITE_URL=https://www.tamidzamin.com
SITE_LAUNCHED=false

# These are optional overrides of the approved public facts, not secrets.
PUBLIC_CONTACT_EMAIL=tamidzaminai@gmail.com
PUBLIC_PHONE=+972584345513
PUBLIC_PHONE_DISPLAY=058-4345513
PUBLIC_WHATSAPP=972584345513
# PUBLIC_LEGAL_NAME identifies the responsible person, not a registered company.
# Leave it unset to use the approved Hebrew operator name from business.json.

# The website has NO contact form. The retired endpoint cannot be enabled
# through environment variables; it returns 410 without processing its body.
LEAD_DELIVERY_ENABLED=false

# Explicit approval of the public policy facts/wording, NOT legal certification.
POLICY_CONTENT_APPROVED=false
CAPABILITIES_APPROVED=false
ASSET_RIGHTS_CONFIRMED=false
LAUNCH_APPROVED=false

# VERCEL and VERCEL_ENV are supplied by Vercel. Do not override them there.
# Only VERCEL_ENV=production can produce indexable Vercel pages.
# Preview/development builds remain noindex; *.vercel.app has noindex headers.
